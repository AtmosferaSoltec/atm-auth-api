APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5433/atm_auth?sslmode=disable
# argon2id cost (defaults are the OWASP minimums)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME=2
ARGON2_THREADS=1
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/atm_auth_test?sslmode=disable

# superadmin shared by the team (not stored in the database). The password has at least 12 characters;
# wrap it in single quotes if it contains $ or #. The service hashes it when it starts.
ADMIN_USER=
ADMIN_PASSWORD=
# RSA key for signing tokens. Generate with: go run ./cmd/genkey
JWT_PRIVATE_KEY=

JWT_ISSUER=atm-auth-api
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=2160h
# Systems that do not remember their users: ceiling for a session left behind (clients drop it when the tab closes)
TEMPORARY_REFRESH_TTL=12h
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW=15m
# Only behind a proxy that overwrites it, e.g. X-Forwarded-For
CLIENT_IP_HEADER=
# Browser origins that call the API directly (comma separated), e.g. the web of each system. Empty: no browser access
CORS_ALLOWED_ORIGINS=
